---
import MotionIntro from "./MotionIntro.astro";
import GradientSheet from "./GradientSheet.astro";
import ScrollCue from "./ScrollCue.astro";
import { url } from "../lib/url";

// julianhilgemann.com's hero, mirrored: the same "Where systems turn data
// into", but here it ends in something you can feel, not a decision. The
// headline's last word takes turns (home.ts). "sound." is literal markup, so
// it is what no-JS and reduced-motion visitors see; the rest travel as an
// expression. The words are orange where the main site's are blue: orange is
// the expressive end of the pair.
const outcomes = ["motion", "light", "colour", "rhythm", "words", "stories"];
const accent = "cycle-word text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary-glow";
---

<section
    id="hero"
    data-hero
    class="min-h-[100svh] pt-24 pb-20 md:py-0 flex flex-col justify-center relative isolate overflow-hidden"
>
    <MotionIntro />

    <!-- ========================================== -->
    <!-- LAYER 1: Gradient sheet (Deepest)          -->
    <!-- ========================================== -->
    <GradientSheet intro class="-z-40" />

    <!-- ========================================== -->
    <!-- LAYER 2: Global Glass Layer (-z-20)        -->
    <!-- Tints and softens the gradient             -->
    <!-- ========================================== -->
    <!-- No blur below md: on a phone, re-blurring a full-screen canvas every
         frame costs scroll smoothness, and the canvas is soft already. -->
    <div class="absolute inset-0 bg-background/20 md:backdrop-blur-[5px] pointer-events-none -z-20"></div>

    <!-- ========================================== -->
    <!-- LAYER 3: Content & Buttons (Top, z-10)     -->
    <!-- ========================================== -->
    <div
        data-hero-content
        class="page-container relative z-10 pointer-events-none"
    >
        <div class="max-w-3xl">
            <h1
                data-hero-title
                data-intro
                class="text-display text-ink-strong mb-6 md:mb-8"
            >
                Where systems turn data into <span data-cycle class="cycle"><span data-cycle-item><span class={accent}>sound.</span></span>{outcomes.map((word) => (
                    <span data-cycle-item aria-hidden="true"><span class={accent}>{word}.</span></span>
                ))}</span>
            </h1>

            <p
                data-hero-fade
                data-intro
                class="text-lead text-ink drop-shadow-md mb-8 md:mb-10 max-w-measure"
            >
                One place where I publish my creative musings
            </p>

            <div data-hero-fade data-intro class="flex flex-wrap gap-3 pointer-events-auto">
                <a
                    href={url("/projects")}
                    class="btn btn-primary"
                >
                    Projects
                </a>
                <a
                    href="#"
                    class="btn js-open-follow"
                    data-location="hero"
                >
                    Follow
                </a>
            </div>
        </div>
    </div>

    <!-- Scroll cue. Below md it sits in the hero's bottom padding, so it
         never overlaps the content on a short phone. -->
    <ScrollCue
        href="#latest"
        label="Scroll to the latest projects"
        data-scroll-cue
        data-intro
        class="absolute bottom-5 md:bottom-10 inset-x-0 mx-auto w-fit z-10"
    />
</section>

<style>
    /* The headline's last word: every word stacked in one grid cell, so the
       slot is as wide as the widest of them and a swap never re-wraps the
       headline. Only the first shows until home.ts takes over. */
    .cycle {
        display: inline-grid;
    }
    .cycle > * {
        grid-area: 1 / 1;
        white-space: nowrap;
    }
    .cycle > * + * {
        visibility: hidden;
    }
    /* The gradient is clipped to the word's box, and the display step's
       negative tracking pulls that box in past the last glyph's ink, which
       shaved its edge. The padding gives the ink room; the margin hands the
       width back so the slot does not grow. The period sits inside the word
       and takes the gradient with it. */
    .cycle-word {
        padding-inline-end: 0.08em;
        margin-inline-end: -0.08em;
    }
</style>
