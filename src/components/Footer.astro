---
import SocialIcon from "./SocialIcon.astro";
import { socials } from "../data/socials";
import { SITE_NAME, mainSite } from "../data/site";
import { url } from "../lib/url";

const year = new Date().getFullYear();
---

<footer
    class="page-container py-12 mt-20 border-t border-line-subtle"
>
    <!-- Row 0: the cross-site link. julianhilgemann.com links here from its
         own footer; each site names the other as its missing half. Blue
         here, because the other half is the system side. -->
    <p class="text-center text-sm text-ink-muted mb-10">
        <a
            href={mainSite("footer")}
            target="_blank"
            rel="noopener noreferrer"
            class="arrow-link group tone-info"
        >
            <span class="text-ink-strong group-hover:text-info transition-colors"
                >The other half: Julian Hilgemann</span
            >
            <span class="arrow" aria-hidden="true">→</span>
        </a>
    </p>

    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
        <!-- Row 1: Social Icons (src/data/socials.ts) -->
        <div
            class="flex gap-4 order-1 md:flex-1 md:justify-start w-full justify-center"
        >
            {
                socials.map((social) => (
                    <a
                        href={social.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-ink-muted hover:text-primary transition-colors"
                    >
                        <span class="sr-only">{social.name}</span>
                        <SocialIcon social={social} />
                    </a>
                ))
            }
        </div>

        <!-- Row 2: Links -->
        <div
            class="flex flex-wrap justify-center gap-4 md:gap-6 text-sm text-ink-muted order-2 md:flex-1"
        >
            <a
                href={url("/impressum")}
                class="hover:text-primary hover:underline underline-offset-4 transition-colors"
                >Imprint</a
            >
            <a
                href={url("/datenschutz")}
                class="hover:text-primary hover:underline underline-offset-4 transition-colors"
                >GDPR</a
            >
            <button
                type="button"
                onclick="window.klaro && window.klaro.show()"
                class="hover:text-primary hover:underline underline-offset-4 cursor-pointer transition-colors"
            >
                Cookies
            </button>
            <a
                href="#"
                class="hover:text-primary hover:underline underline-offset-4 js-open-follow transition-colors"
                data-location="footer-link">Contact</a
            >
        </div>

        <!-- Row 3: Copyright -->
        <div
            class="text-xs text-ink-faint text-center order-3 md:flex-1 md:text-right w-full"
        >
            &copy; {year} {SITE_NAME}
        </div>
    </div>
</footer>
