---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import FollowModal from "../components/FollowModal.astro";
import { url, isPreview } from "../lib/url";

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: string;
	fullWidth?: boolean;
	noTopPadding?: boolean;
	noHeader?: boolean;
	noFooter?: boolean;
	noAnalytics?: boolean;
	/** Keep the page out of search results. */
	noindex?: boolean;
}

// Link-preview image, 1200 x 630. Drawn and rendered by scripts/og-image.html.
const DEFAULT_IMAGE = "/og-image.jpg";

// GA4 measurement ID. Empty until the Hyperadapted property exists: the
// consent defaults and the Klaro banner run regardless, and gtag.js loads
// once an ID is set here.
const GA_ID = "";

const {
	title,
	description = "Hyperadapted: writing, audiovisual art and music, where data turns back into something you can feel.",
	image = DEFAULT_IMAGE,
	type = "website",
	fullWidth = false,
	noTopPadding = false,
	noHeader = false,
	noFooter = false,
	noAnalytics = false,
	noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(url(image), Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
		<link rel="icon" type="image/png" sizes="32x32" href={url("/favicon-32.png")} />
		<link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={canonicalURL} />
		{/* The github.io preview stays out of search until the domain moves. */}
		{(noindex || isPreview) && <meta name="robots" content="noindex" />}

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		{image === DEFAULT_IMAGE && (
			<>
				<meta property="og:image:width" content="1200" />
				<meta property="og:image:height" content="630" />
				<meta
					property="og:image:alt"
					content="Hyperadapted: where data turns back into sound, over a dark field of blue and orange light."
				/>
			</>
		)}

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={imageURL} />

		<!-- Consent Mode v2 defaults: DENY until user consents -->
		{!noAnalytics && (
			<>
				<script is:inline>
					window.dataLayer = window.dataLayer || [];
					function gtag() {
						dataLayer.push(arguments);
					}
					gtag("consent", "default", {
						ad_storage: "denied",
						ad_user_data: "denied",
						ad_personalization: "denied",
						analytics_storage: "denied",
						functionality_storage: "denied",
						personalization_storage: "denied",
						security_storage: "granted",
						wait_for_update: 500,
					});

					gtag("js", new Date());
				</script>

				{GA_ID && (
					<>
						<!-- Google tag (gtag.js) -->
						<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
						<script is:inline set:html={`gtag("config", ${JSON.stringify(GA_ID)}, { anonymize_ip: true });`}></script>
					</>
				)}

				<!-- Klaro! (CMP) via CDN -->
				<link
					rel="stylesheet"
					href="https://cdn.jsdelivr.net/npm/klaro@0.7.21/dist/klaro.min.css"
				/>
				<script
					src="https://cdn.jsdelivr.net/npm/klaro@0.7.21/dist/klaro.min.js"
					defer></script>
				<script defer is:inline>
					// Minimal Klaro config (EN banner, opt-in for GA4).
					window.klaroConfig = {
						version: 1,
						acceptAll: true,
						hideDeclineAll: false,
						noAutoLoad: false,
						htmlTexts: false,
						elementID: "klaro",
						styling: { theme: ["top", "wide"] },
						lang: "en",
						translations: {
							en: {
								consentModal: {
									title: "Privacy Settings",
									description:
										"We use cookies and similar technologies. You can change your choices at any time.",
								},
								consentNotice: {
									description:
										"We use Google Analytics (optional) to improve the user experience.",
									learnMore: "Settings",
								},
								ok: "Accept Selected",
								acceptAll: "Accept all (allow Analytics)",
								decline: "Decline (necessary cookies only)",
								save: "Save",
								purposes: { analytics: "Analytics" },
							},
						},
						services: [
							{
								name: "google-analytics",
								title: "Google Analytics 4",
								default: true,
								purposes: ["analytics"],
								cookies: [/^_ga(_.*)?/, /^_gid/],
								onAccept: () => {
									gtag("consent", "update", {
										analytics_storage: "granted",
										ad_storage: "granted",
										ad_user_data: "granted",
										ad_personalization: "granted",
									});
								},
								onDecline: () => {
									gtag("consent", "update", {
										analytics_storage: "denied",
										ad_storage: "denied",
										ad_user_data: "denied",
										ad_personalization: "denied",
									});
								},
							},
						],
					};
				</script>
			</>
		)}
	</head>
	<body
		class="bg-background text-ink min-h-[100svh] flex flex-col"
	>
		{!noHeader && <Nav />}
		<main
			class:list={[
				"flex-grow w-full",
				noTopPadding ? "" : "pt-nav",
				fullWidth ? "" : "page-container",
			]}
		>
			<slot />
		</main>
		{!noFooter && <Footer />}
		<FollowModal />
	</body>
</html>
