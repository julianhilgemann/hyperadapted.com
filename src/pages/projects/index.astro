---
import Layout from "../../layouts/Layout.astro";
import MotionIntro from "../../components/MotionIntro.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import FollowCTA from "../../components/FollowCTA.astro";
import ScrollCue from "../../components/ScrollCue.astro";
import { getProjects } from "../../lib/projects";

// Every published piece, newest first: a two-column grid of cards, the
// newest one spanning both. The same layout as julianhilgemann.com/projects,
// except that an even count fills the grid without a featured card, so the
// last row never ends on a gap.
const projects = await getProjects();
const featureFirst = projects.length % 2 === 1;
---

<Layout
    title="Projects | Hyperadapted"
    description="Every project from Hyperadapted: generative audiovisual pieces built in TouchDesigner and audio-reactive 3D animation rendered in Blender."
    fullWidth={true}
>
    <MotionIntro />

    <section class="section-intro page-container relative isolate">
        <div class="max-w-3xl">
            <h1 data-page-title data-intro class="text-h1 text-ink-strong mb-8">
                Projects
            </h1>
            <p data-intro data-intro-fade class="text-lead text-ink-muted">
                Generative audiovisual pieces that run live in TouchDesigner,
                and 3D animation rendered from the music in Blender. Newest
                first.
            </p>
        </div>

        <ScrollCue href="#project-list" label="Scroll to the projects" data-intro data-intro-fade />
    </section>

    <section id="project-list" class="pb-section scroll-mt-nav">
        <div class="page-container">
            {
                projects.length ? (
                    <ul data-reveal-batch class="grid lg:grid-cols-2 gap-grid">
                        {projects.map((project, i) => (
                            <li class:list={[featureFirst && i === 0 && "lg:col-span-2"]}>
                                <ProjectCard project={project} featured={featureFirst && i === 0} as="h2" />
                            </li>
                        ))}
                    </ul>
                ) : (
                    <p class="card text-ink-muted">The first pieces are on their way.</p>
                )
            }
        </div>
    </section>

    <FollowCTA />
</Layout>

<script>
    import "../../scripts/page";
</script>
